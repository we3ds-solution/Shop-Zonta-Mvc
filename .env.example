# Zonta Egypt — local environment template (placeholders only, never commit secrets)
# Copy to .env for local tooling if needed. ASP.NET Core reads double-underscore vars natively.

# SQL Server connection (use user-secrets or hosting secret manager in real use)
ConnectionStrings__DefaultConnection=Server=(localdb)\mssqllocaldb;Database=zonta_store_db;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=True

# First-admin bootstrap (explicit opt-in only; never log this password)
ZONTA_SEED_ADMIN=false
ZONTA_ADMIN_EMAIL=admin@example.com
# Set a strong unique password via env / user-secrets — do not put real values here
ZONTA_ADMIN_PASSWORD=

# Store settings (currency requires official confirmation)
Zonta__Currency=EGP
Zonta__ShippingFee=0
