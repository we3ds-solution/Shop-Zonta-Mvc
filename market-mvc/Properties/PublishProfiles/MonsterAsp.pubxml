<?xml version="1.0" encoding="utf-8"?>
<!--
  Publish profile for MonsterASP / Windows hosting (dotnet publish or VS Publish).
  Usage:
    dotnet publish market-mvc/market-mvc.csproj -c Release -p:PublishProfile=MonsterAsp
  Output lands in ..\..\deploy\zonta-store\ — upload that folder's contents
  to the hosting document root via Plesk File Manager / FTP / Git.
-->
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <WebPublishMethod>FileSystem</WebPublishMethod>
    <PublishProvider>FileSystem</PublishProvider>
    <Configuration>Release</Configuration>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>market-mvc</AssemblyName>
    <OutputPath>bin\Release\net9.0\publish\</OutputPath>
    <PublishDir>..\..\deploy\zonta-store\</PublishDir>
    <DeleteExistingFiles>true</DeleteExistingFiles>
  </PropertyGroup>
</Project>
