{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    // DO NOT commit real credentials here. Set via environment variable:
    //   ConnectionStrings__DefaultConnection="Server=...;Database=...;User Id=...;Password=...;Encrypt=True;TrustServerCertificate=False"
    // Or via dotnet user-secrets / hosting secret manager. See README + .env.example.
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=zonta_store_db;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=True"
  },
  "Zonta": {
    // Currency requires official confirmation (shopzonta.com was inaccessible 2026-10-10, Cloudflare 409).
    // Default EGP based on Egyptian brand context; confirm before production pricing.
    "Currency": "EGP",
    "StoreName": "Zonta Egypt",
    "SupportEmail": "",
    "SeedDemoCatalog": false
  },
  "AdminBootstrap": {
    // First-admin provisioning is environment-driven only. No default passwords.
    // Set ZONTA_ADMIN_EMAIL + ZONTA_ADMIN_PASSWORD env vars and ZONTA_SEED_ADMIN=true to provision.
    "Enabled": false
  }
}
