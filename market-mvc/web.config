<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS hosting config for MonsterASP / runasp.net (and any IIS host).
  Keep this file minimal: MonsterASP locks some sections and manages
  environment variables from its Control Panel. Do NOT add custom
  environmentVariables here — set them in the Control Panel instead, e.g.
    ConnectionStrings__DefaultConnection  (your MSSQL connection string)
    ZONTA_SEED_ADMIN / ZONTA_ADMIN_EMAIL / ZONTA_ADMIN_PASSWORD (first admin)
  stdout logging below is a temporary diagnostic for startup failures
  (HTTP 500.30): read logs\stdout_*.log via the Plesk File Manager,
  then set stdoutLogEnabled="false" before heavy traffic.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet"
                  arguments=".\market-mvc.dll"
                  stdoutLogEnabled="true"
                  stdoutLogFile=".\logs\stdout"
                  hostingModel="inprocess" />
    </system.webServer>
  </location>
</configuration>
