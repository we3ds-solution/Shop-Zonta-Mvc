<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RestoreSources>https://api.nuget.org/v3/index.json</RestoreSources>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Zonta.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AutoMapper" Version="12.0.1" />
    <PackageReference Include="AutoMapper.Extensions.Microsoft.DependencyInjection" Version="12.0.1" />
    <PackageReference Include="FluentValidation" Version="11.9.0" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="11.9.0" />
    <PackageReference Include="MediatR" Version="14.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="9.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="9.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.10" /><!-- Also enables Database:Provider=Sqlite for local dev/tests -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="9.0.10">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <!-- Explicit logical names: the assembly is market-mvc (hyphen) but the
         ResourceManager base name is market_mvc.Resources.SharedValidation. -->
    <EmbeddedResource Update="Resources\SharedValidation.resx" LogicalName="market_mvc.Resources.SharedValidation.resources" />
    <EmbeddedResource Update="Resources\SharedValidation.en.resx" LogicalName="market_mvc.Resources.SharedValidation.en.resources" />
    <EmbeddedResource Update="Resources\SharedValidation.ar.resx" LogicalName="market_mvc.Resources.SharedValidation.ar.resources" />
  </ItemGroup>

</Project>
