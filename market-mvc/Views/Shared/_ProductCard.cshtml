@model market_mvc.Domain.ViewModels.Product.ProductCardVM
@inject market_mvc.Infrastructure.Localization.IZontaLocalizer L

<div class="col">
    <div class="card product-card h-100 shadow-sm">
        @if (Model.IsOnSale)
        {
            <div class="position-absolute top-0 start-0 m-2">
                <span class="badge bg-danger">
                    @if (Model.SavingsPercentage.HasValue)
                    {
                        <text>-@Model.SavingsPercentage.Value%</text>
                    }
                    else
                    {
                        <text>@L.Get("Card.Sale")</text>
                    }
                </span>
            </div>
        }

        @if (Model.IsFeatured)
        {
            <div class="position-absolute top-0 end-0 m-2">
                <span class="badge bg-warning text-dark">
                    <i class="fas fa-star"></i> @L.Get("Card.Featured")
                </span>
            </div>
        }

        @if (Model.IsOutOfStock)
        {
            <div class="position-absolute top-50 start-50 translate-middle">
                <span class="badge bg-danger fs-6 px-3 py-2">@L.Get("Card.OOS")</span>
            </div>
        }

        <div class="card-img-container position-relative">
            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <img src="@Model.ImageUrl"
                     alt="@(Model.ImageAlt ?? Model.Name)"
                     loading="lazy"
                     onerror="this.onerror=null;this.src='/images/products/placeholder.svg';"
                     class="card-img-top product-card-image @(Model.IsOutOfStock ? "out-of-stock" : "")" />
            }
            else
            {
                @* Real Zonta Instagram brand image as fallback (no fabricated art) *@
                <img src="/images/categories/footwear/habibi-sneakers.jpg"
                     alt="@L.Get("Card.BrandAlt")"
                     loading="lazy"
                     class="card-img-top product-card-image @(Model.IsOutOfStock ? "out-of-stock" : "")" />
            }
        </div>

        <div class="card-body d-flex flex-column">
            @if (!string.IsNullOrEmpty(Model.CategoryName))
            {
                <small class="text-muted mb-1">@Model.CategoryName</small>
            }

            <h5 class="card-title">@Model.Name</h5>

            @if (!string.IsNullOrEmpty(Model.Description))
            {
                <p class="card-text text-muted small">
                    @(Model.Description.Length > 80 ? Model.Description.Substring(0, 80) + "..." : Model.Description)
                </p>
            }

            <div class="mt-auto">
                <div class="price-section mb-3">
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <span class="h5 mb-0 zonta-price">@Model.Price.ToString("N2") EGP</span>
                        @if (Model.CompareAtPrice.HasValue && Model.CompareAtPrice > Model.Price)
                        {
                            <span class="text-muted text-decoration-line-through">@Model.CompareAtPrice.Value.ToString("N2") EGP</span>
                            @if (Model.SavingsAmount.HasValue)
                            {
                                <small class="text-success fw-bold">@L.Get("Card.Save") @Model.SavingsAmount.Value.ToString("N2") EGP</small>
                            }
                        }
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <a asp-controller="Products" asp-action="Details" asp-route-id="@Model.Id"
                       class="btn btn-outline-primary btn-sm flex-fill" aria-label="View @Model.Name">
                        <i class="fas fa-eye me-1"></i>@L.Get("Card.View")
                    </a>
                    @if (!Model.IsOutOfStock && !Model.HasVariants)
                    {
                        <form asp-controller="Cart" asp-action="Add" method="post" class="flex-fill d-flex">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="ProductId" value="@Model.Id" />
                            <input type="hidden" name="Quantity" value="1" />
                            <button type="submit" class="btn btn-primary btn-sm flex-fill" aria-label="Add @Model.Name to cart">
                                <i class="fas fa-shopping-bag me-1"></i>@L.Get("Card.Add")
                            </button>
                        </form>
                    }
                    else if (!Model.IsOutOfStock && Model.HasVariants)
                    {
                        <a asp-controller="Products" asp-action="Details" asp-route-id="@Model.Id"
                           class="btn btn-primary btn-sm flex-fill" aria-label="Select options for @Model.Name">
                            <i class="fas fa-list me-1"></i>@L.Get("Card.Options")
                        </a>
                    }
                    else
                    {
                        <button class="btn btn-secondary btn-sm flex-fill" disabled>
                            <i class="fas fa-times me-1"></i>@L.Get("Card.OOS")
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
