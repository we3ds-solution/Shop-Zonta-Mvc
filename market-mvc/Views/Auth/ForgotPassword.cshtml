@model market_mvc.Domain.ViewModels.Auth.ForgotPasswordVM

@{
    ViewData["Title"] = "Forgot password";
    ViewBag.PageTitle = "Forgot password";
    ViewBag.Breadcrumbs = new List<(string Name, string Controller, string Action)>
    {
        ("Login", "Auth", "Login"),
        ("Forgot password", "Auth", "ForgotPassword")
    };
}

@await Html.PartialAsync("_PageHeader")

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="form-enhanced">
                <form asp-action="ForgotPassword" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                    <div class="form-group">
                        <label asp-for="Email" class="control-label"></label>
                        <input asp-for="Email" class="form-control" autocomplete="email" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                    <div class="form-group d-flex gap-2 flex-wrap">
                        <button type="submit" class="btn btn-custom-primary">Send reset link</button>
                        <a asp-action="Login" class="btn btn-custom-secondary">Back to login</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
