@model market_mvc.Domain.entity.ApplicationUser
@inject market_mvc.Infrastructure.Localization.IZontaLocalizer L

@{
    ViewData["Title"] = L.Get("Profile.Title");
    ViewBag.PageTitle = L.Get("Profile.Title");
    ViewBag.Breadcrumbs = new List<(string Name, string Controller, string Action)>
    {
        (L.Get("Profile.Title"), "Auth", "Profile")
    };
    var isAr = L.Culture == "ar";
}

@await Html.PartialAsync("_PageHeader")

<div class="container">
    <div class="row g-4">
        <div class="col-md-6">
            <div class="content-card">
                <h2 class="h4">@(isAr ? "الملف الشخصي" : "Profile")</h2>
                <dl class="row">
                    <dt class="col-sm-4">@(isAr ? "الاسم" : "Name")</dt>
                    <dd class="col-sm-8">@Model.FullName</dd>
                    <dt class="col-sm-4">@(isAr ? "البريد" : "Email")</dt>
                    <dd class="col-sm-8">@Model.Email</dd>
                    <dt class="col-sm-4">@(isAr ? "الحالة" : "Status")</dt>
                    <dd class="col-sm-8">@(Model.IsActive ? (isAr ? "نشط" : "Active") : (isAr ? "موقوف" : "Deactivated"))</dd>
                </dl>
            </div>
        </div>
        <div class="col-md-6">
            <div class="content-card">
                <h2 class="h4">@L.Get("Profile.Orders")</h2>
                <p class="text-muted">@(isAr ? "اعرض سجل طلباتك. لا يمكنك الوصول إلا لطلباتك الخاصة." : "View your order history. You can only access your own orders.")</p>
                <a asp-controller="Orders" asp-action="Index" class="btn btn-custom-primary">@L.Get("Orders.History")</a>
                <a asp-controller="Cart" asp-action="Index" class="btn btn-custom-secondary ms-2">@L.Get("Nav.Cart")</a>
                <a asp-controller="Auth" asp-action="Setup2fa" class="btn btn-outline-dark btn-sm ms-2">@(isAr ? "المصادقة الثنائية" : "Two-factor auth")</a>
            </div>
        </div>
    </div>
</div>
