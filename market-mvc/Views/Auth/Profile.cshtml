@model market_mvc.Domain.entity.ApplicationUser

@{
    ViewData["Title"] = "My account";
    ViewBag.PageTitle = "My account";
    ViewBag.Breadcrumbs = new List<(string Name, string Controller, string Action)>
    {
        ("Account", "Auth", "Profile")
    };
}

@await Html.PartialAsync("_PageHeader")

<div class="container">
    <div class="row g-4">
        <div class="col-md-6">
            <div class="content-card">
                <h2 class="h4">Profile</h2>
                <dl class="row">
                    <dt class="col-sm-4">Name</dt>
                    <dd class="col-sm-8">@Model.FullName</dd>
                    <dt class="col-sm-4">Email</dt>
                    <dd class="col-sm-8">@Model.Email</dd>
                    <dt class="col-sm-4">Status</dt>
                    <dd class="col-sm-8">@(Model.IsActive ? "Active" : "Deactivated")</dd>
                </dl>
            </div>
        </div>
        <div class="col-md-6">
            <div class="content-card">
                <h2 class="h4">My orders</h2>
                <p class="text-muted">View your order history. You can only access your own orders.</p>
                <a asp-controller="Orders" asp-action="Index" class="btn btn-custom-primary">Order history</a>
                <a asp-controller="Cart" asp-action="Index" class="btn btn-custom-secondary ms-2">Cart</a>
            </div>
        </div>
    </div>
</div>
