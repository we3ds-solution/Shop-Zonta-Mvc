@inject market_mvc.Infrastructure.Localization.IZontaLocalizer L
@{
    ViewData["Title"] = L.Get("Auth.CheckMail");
    ViewBag.PageTitle = L.Get("Auth.CheckMail");
}

@await Html.PartialAsync("_PageHeader")

<div class="container">
    <div class="content-card text-center py-5">
        <i class="fas fa-envelope fa-3x text-muted mb-3" aria-hidden="true"></i>
        <h2>@L.Get("Auth.CheckMail")</h2>
        <p class="text-muted">@L.Get("Auth.CheckMailBody")</p>
        <p class="text-muted small">@L.Get("Auth.MailDevNote")</p>
        <a asp-action="Login" class="btn btn-custom-primary mt-2">@L.Get("Auth.BackLogin")</a>
    </div>
</div>
