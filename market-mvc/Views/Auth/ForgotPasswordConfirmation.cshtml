@{
    ViewData["Title"] = "Check your email";
    ViewBag.PageTitle = "Check your email";
}

@await Html.PartialAsync("_PageHeader")

<div class="container">
    <div class="content-card text-center py-5">
        <i class="fas fa-envelope fa-3x text-muted mb-3" aria-hidden="true"></i>
        <h2>If the address is registered, a reset link is on its way</h2>
        <p class="text-muted">In development the message is written to <code>App_Data/mail</code>; in production it is emailed.</p>
        <a asp-action="Login" class="btn btn-custom-primary mt-2">Back to login</a>
    </div>
</div>
