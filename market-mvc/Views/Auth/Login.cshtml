@model market_mvc.Domain.ViewModels.Auth.LoginVM
@inject market_mvc.Infrastructure.Localization.IZontaLocalizer L

@{
    ViewData["Title"] = L.Get("Auth.SignIn");
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-lg">
                <div class="card-body p-5">
                    <h2 class="card-title text-center mb-4">@L.Get("Auth.LoginHeading")</h2>

                    @if (ViewData["ReturnUrl"] != null)
                    {
                        <div class="alert alert-info" role="alert">
                            @L.Get("Auth.LoginInfo")
                        </div>
                    }

                    <form asp-action="Login" asp-controller="Auth" method="post" novalidate>
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email" type="email" class="form-control" placeholder="@L.Get("Auth.EmailPh")" required />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Password" class="form-label"></label>
                            <input asp-for="Password" type="password" class="form-control" placeholder="@L.Get("Auth.PassPh")" required />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <div class="mb-3 form-check">
                            <input asp-for="RememberMe" type="checkbox" class="form-check-input" />
                            <label asp-for="RememberMe" class="form-check-label"></label>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 py-2 fs-6">@L.Get("Auth.SignIn")</button>
                    </form>

                    <div class="text-center mt-3">
                        <a asp-action="ForgotPassword" asp-controller="Auth" class="text-decoration-none">@L.Get("Auth.Forgot")</a>
                    </div>

                    @if (ViewBag.ShowResend == true)
                    {
                        <div class="alert alert-warning mt-3" role="alert">
                            <form asp-action="ResendConfirmation" asp-controller="Auth" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="email" value="@ViewBag.ResendEmail" />
                                <button type="submit" class="btn btn-link p-0 align-baseline">Resend confirmation</button>
                            </form>
                        </div>
                    }

                    <hr class="my-4" />

                    <div class="text-center">
                        <p class="mb-0">
                            @L.Get("Auth.NoAccount")
                            <a asp-action="Register" asp-controller="Auth" class="text-decoration-none fw-bold">@L.Get("Auth.RegisterHere")</a>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
