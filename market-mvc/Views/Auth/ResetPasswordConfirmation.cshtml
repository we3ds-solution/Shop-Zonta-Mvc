@inject market_mvc.Infrastructure.Localization.IZontaLocalizer L
@{
    ViewData["Title"] = L.Get("Auth.ResetTitle");
    ViewBag.PageTitle = L.Get("Auth.ResetTitle");
}

@await Html.PartialAsync("_PageHeader")

<div class="container">
    <div class="content-card text-center py-5">
        <i class="fas fa-check-circle fa-3x text-success mb-3" aria-hidden="true"></i>
        <h2>@L.Get("Auth.ResetDone")</h2>
        <a asp-action="Login" class="btn btn-custom-primary mt-3">@L.Get("Auth.SignIn")</a>
    </div>
</div>
