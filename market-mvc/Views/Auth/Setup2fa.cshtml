@model market_mvc.Domain.ViewModels.Auth.Setup2faVM
@inject market_mvc.Infrastructure.Localization.IZontaLocalizer L

@{
    ViewData["Title"] = L.Get("Auth.SetupTitle");
    ViewBag.PageTitle = L.Get("Auth.TfaTitle");
}

@await Html.PartialAsync("_PageHeader")

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-7">
            <div class="form-enhanced">
                @if (Model.IsEnabled)
                {
                    <div class="alert alert-success" role="status">@L.Get("Auth.SetupOn")</div>
                }
                <ol>
                    <li>@L.Get("Auth.SetupS1")</li>
                    <li>@L.Get("Auth.SetupS2")<br /><code>@Model.Secret</code></li>
                    <li>@L.Get("Auth.SetupS3")<br /><code class="text-break">@Model.KeyUri</code></li>
                    <li>@L.Get("Auth.SetupS4")</li>
                </ol>
                <form asp-action="Setup2fa" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Secret" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                    <div class="form-group">
                        <label asp-for="Code" class="control-label"></label>
                        <input asp-for="Code" class="form-control" autocomplete="one-time-code" inputmode="numeric" maxlength="6" />
                        <span asp-validation-for="Code" class="text-danger"></span>
                    </div>
                    <div class="form-group d-flex gap-2 flex-wrap">
                        <button type="submit" class="btn btn-custom-primary">@L.Get("Auth.Enable2fa")</button>
                        <a asp-action="Profile" class="btn btn-custom-secondary">@L.Get("Auth.BackAccount")</a>
                    </div>
                </form>
                @if (Model.IsEnabled)
                {
                    <form asp-action="Disable2fa" method="post" class="mt-3">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-danger btn-sm">@L.Get("Auth.Disable2fa")</button>
                    </form>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
