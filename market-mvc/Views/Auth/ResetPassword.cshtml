@model market_mvc.Domain.ViewModels.Auth.ResetPasswordVM
@inject market_mvc.Infrastructure.Localization.IZontaLocalizer L

@{
    ViewData["Title"] = L.Get("Auth.ResetTitle");
    ViewBag.PageTitle = L.Get("Auth.ResetTitle");
    ViewBag.Breadcrumbs = new List<(string Name, string Controller, string Action)>
    {
        (L.Get("Auth.SignIn"), "Auth", "Login"),
        (L.Get("Auth.ResetTitle"), "Auth", "ResetPassword")
    };
}

@await Html.PartialAsync("_PageHeader")

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="form-enhanced">
                <form asp-action="ResetPassword" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Email" />
                    <input type="hidden" asp-for="Token" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                    <div class="form-group">
                        <label asp-for="Password" class="control-label"></label>
                        <input asp-for="Password" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="ConfirmPassword" class="control-label"></label>
                        <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <button type="submit" class="btn btn-custom-primary">@L.Get("Auth.ResetTitle")</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
