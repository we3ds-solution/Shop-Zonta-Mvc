@model market_mvc.Domain.ViewModels.Cart.CartVM
@inject market_mvc.Infrastructure.Localization.IZontaLocalizer L

@{
    ViewData["Title"] = L.Get("Cart.Title");
    ViewData["Description"] = "Your Zonta Egypt shopping cart.";
    ViewBag.PageTitle = L.Get("Cart.Title");
    ViewBag.Breadcrumbs = new List<(string Name, string Controller, string Action)>
    {
        (L.Get("Cart.Title"), "Cart", "Index")
    };
}

@await Html.PartialAsync("_PageHeader")

<div class="container">
    @if (Model.IsEmpty)
    {
        <div class="content-card text-center py-5" role="status">
            <i class="fas fa-shopping-bag fa-3x text-muted mb-3" aria-hidden="true"></i>
            <h2>@L.Get("Cart.Empty")</h2>
            <p class="text-muted">@L.Get("Cart.EmptyHint")</p>
            <a asp-controller="Products" asp-action="Index" class="btn btn-custom-primary mt-2">@L.Get("Common.ShopNow")</a>
        </div>
    }
    else
    {
        <div class="content-card">
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th scope="col">Product</th>
                            <th scope="col">Unit price</th>
                            <th scope="col">Quantity</th>
                            <th scope="col">Total</th>
                            <th scope="col"><span class="visually-hidden">Actions</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-3">
                                        @if (!string.IsNullOrEmpty(item.ImageUrl))
                                        {
                                            <img src="@item.ImageUrl" alt="@(item.ImageAlt ?? item.ProductName)" width="64" height="64" style="object-fit: cover;" class="rounded" loading="lazy" onerror="this.onerror=null;this.src='/images/categories/footwear/habibi-sneakers.jpg';" />
                                        }
                                        else
                                        {
                                            <img src="/images/categories/footwear/habibi-sneakers.jpg" alt="@(item.ImageAlt ?? item.ProductName)" width="64" height="64" style="object-fit: cover;" class="rounded" loading="lazy" />
                                        }
                                        <div>
                                            <a asp-controller="Products" asp-action="Details" asp-route-id="@item.ProductId">@item.DisplayName</a>
                                            @if (!item.IsAvailable)
                                            {
                                                <div><span class="badge bg-secondary">Unavailable</span></div>
                                            }
                                        </div>
                                    </div>
                                </td>
                                <td>@item.UnitPrice.ToString("N2") EGP</td>
                                <td>
                                    <form asp-action="Update" method="post" class="d-flex gap-2">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="productId" value="@item.ProductId" />
                                        <input type="hidden" name="variantId" value="@item.VariantId" />
                                        <label class="visually-hidden" for="qty-@item.ProductId">Quantity for @item.DisplayName</label>
                                        <input id="qty-@item.ProductId" name="quantity" type="number" value="@item.Quantity" min="0" max="99" class="form-control" style="width: 90px;" />
                                        <button type="submit" class="btn btn-outline-primary btn-sm">@L.Get("Cart.Update")</button>
                                    </form>
                                </td>
                                <td class="fw-bold">@item.LineTotal.ToString("N2") EGP</td>
                                <td>
                                    <form asp-action="Remove" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="productId" value="@item.ProductId" />
                                        <input type="hidden" name="variantId" value="@item.VariantId" />
                                        <button type="submit" class="btn btn-outline-danger btn-sm" aria-label="Remove @item.DisplayName">@L.Get("Cart.Remove")</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="d-flex justify-content-end">
                <div class="text-end">
                    <p class="mb-1">@L.Get("Cart.Subtotal"): <strong>@Model.SubTotal.ToString("N2") EGP</strong></p>
                    <p class="mb-1">@L.Get("Cart.Shipping"): <strong>@(Model.ShippingAmount == 0 ? L.Get("Cart.FreeShipNote") + " (0.00 EGP)" : Model.ShippingAmount.ToString("N2") + " EGP")</strong></p>
                    <p class="h5">@L.Get("Cart.Total"): <strong>@Model.Total.ToString("N2") EGP</strong></p>
                    <p class="small text-muted">@L.Get("Cart.Recalc")</p>
                    <div class="d-flex gap-2 justify-content-end flex-wrap">
                        <a asp-controller="Products" asp-action="Index" class="btn btn-custom-secondary">@L.Get("Cart.Continue")</a>
                        <a asp-action="Checkout" class="btn btn-custom-primary">@L.Get("Cart.Checkout")</a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
