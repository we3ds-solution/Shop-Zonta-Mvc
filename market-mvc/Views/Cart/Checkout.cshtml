@model market_mvc.Domain.ViewModels.Cart.CheckoutVM
@inject market_mvc.Infrastructure.Localization.IZontaLocalizer L

@{
    ViewData["Title"] = L.Get("Checkout.Title");
    ViewData["Description"] = "Zonta Egypt checkout — cash on delivery.";
    ViewBag.PageTitle = L.Get("Checkout.Title");
    ViewBag.Breadcrumbs = new List<(string Name, string Controller, string Action)>
    {
        (L.Get("Cart.Title"), "Cart", "Index"),
        (L.Get("Checkout.Title"), "Cart", "Checkout")
    };
}

@await Html.PartialAsync("_PageHeader")

<div class="container">
    <div class="row g-4">
        <div class="col-12 col-lg-7">
            <div class="form-enhanced">
                <h2 class="h4 mb-3">@L.Get("Checkout.Contact")</h2>
                <form asp-action="Checkout" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                    <div class="row">
                        <div class="col-md-6 form-group">
                            <label asp-for="FirstName" class="control-label"></label>
                            <input asp-for="FirstName" class="form-control" autocomplete="given-name" />
                            <span asp-validation-for="FirstName" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 form-group">
                            <label asp-for="LastName" class="control-label"></label>
                            <input asp-for="LastName" class="form-control" autocomplete="family-name" />
                            <span asp-validation-for="LastName" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 form-group">
                            <label asp-for="Email" class="control-label"></label>
                            <input asp-for="Email" class="form-control" autocomplete="email" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 form-group">
                            <label asp-for="Phone" class="control-label"></label>
                            <input asp-for="Phone" class="form-control" autocomplete="tel" />
                            <span asp-validation-for="Phone" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="form-group">
                        <label asp-for="Street" class="control-label"></label>
                        <input asp-for="Street" class="form-control" autocomplete="street-address" />
                        <span asp-validation-for="Street" class="text-danger"></span>
                    </div>
                    <div class="row">
                        <div class="col-md-4 form-group">
                            <label asp-for="City" class="control-label"></label>
                            <input asp-for="City" class="form-control" />
                            <span asp-validation-for="City" class="text-danger"></span>
                        </div>
                        <div class="col-md-4 form-group">
                            <label asp-for="State" class="control-label"></label>
                            <input asp-for="State" class="form-control" />
                            <span asp-validation-for="State" class="text-danger"></span>
                        </div>
                        <div class="col-md-4 form-group">
                            <label asp-for="ZipCode" class="control-label"></label>
                            <input asp-for="ZipCode" class="form-control" />
                            <span asp-validation-for="ZipCode" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="form-group">
                        <label asp-for="Country" class="control-label"></label>
                        <input asp-for="Country" class="form-control" />
                        <span asp-validation-for="Country" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="Notes" class="control-label">@L.Get("Checkout.Notes")</label>
                        <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Notes" class="text-danger"></span>
                    </div>
                    <div class="alert alert-info" role="note">
                        <i class="fas fa-money-bill-wave me-2" aria-hidden="true"></i>
                        @L.Get("Checkout.CodNote")
                    </div>
                    <div class="d-flex gap-2 flex-wrap">
                        <button type="submit" class="btn btn-custom-primary btn-lg">@L.Get("Checkout.Place")</button>
                        <a asp-action="Index" class="btn btn-custom-secondary">@L.Get("Checkout.Back")</a>
                    </div>
                </form>
            </div>
        </div>
        <div class="col-12 col-lg-5">
            <div class="content-card">
                <h2 class="h4 mb-3">@L.Get("Checkout.Summary")</h2>
                @if (Model.Cart.IsEmpty)
                {
                    <p class="text-muted">@L.Get("Cart.Empty")</p>
                }
                else
                {
                    <ul class="list-group mb-3">
                        @foreach (var item in Model.Cart.Items)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <span>@item.DisplayName × @item.Quantity</span>
                                <strong>@item.LineTotal.ToString("N2") EGP</strong>
                            </li>
                        }
                    </ul>
                    <p class="mb-1">@L.Get("Cart.Subtotal"): <strong>@Model.Cart.SubTotal.ToString("N2") EGP</strong></p>
                    <p class="mb-1">@L.Get("Cart.Shipping"): <strong>@Model.Cart.ShippingAmount.ToString("N2") EGP</strong></p>
                    <p class="h5">@L.Get("Cart.Total"): <strong>@Model.Cart.Total.ToString("N2") EGP</strong></p>
                    <p class="small text-muted mb-0">@L.Get("Checkout.ServerNote")</p>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
