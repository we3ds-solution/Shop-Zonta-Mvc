@model market_mvc.Domain.entity.Order

@{
    ViewData["Title"] = "Order confirmation";
    ViewData["Description"] = "Your Zonta Egypt order confirmation.";
    ViewBag.PageTitle = "Thank you — order received";
    ViewBag.Breadcrumbs = new List<(string Name, string Controller, string Action)>
    {
        ("Orders", "Orders", "Index"),
        ("Confirmation", "Cart", "Confirmation")
    };
}

@await Html.PartialAsync("_PageHeader")

<div class="container">
    <div class="content-card text-center py-4">
        <i class="fas fa-check-circle fa-3x text-success mb-3" aria-hidden="true"></i>
        <h2>Order @Model.OrderNumber received</h2>
        <p class="text-muted">Cash on delivery — payment pending. We will contact you to confirm delivery.</p>
        <div class="row justify-content-center text-start mt-4">
            <div class="col-md-8">
                <dl class="row">
                    <dt class="col-sm-4">Order number</dt>
                    <dd class="col-sm-8"><code>@Model.OrderNumber</code></dd>
                    <dt class="col-sm-4">Total</dt>
                    <dd class="col-sm-8 fw-bold">@Model.Total.ToString("N2") EGP</dd>
                    <dt class="col-sm-4">Payment</dt>
                    <dd class="col-sm-8">@(Model.PaymentMethod ?? "Cash on Delivery") (@Model.PaymentStatus)</dd>
                    <dt class="col-sm-4">Status</dt>
                    <dd class="col-sm-8">@Model.Status</dd>
                </dl>
                @if (Model.OrderItems.Any())
                {
                    <ul class="list-group mb-3">
                        @foreach (var item in Model.OrderItems)
                        {
                            <li class="list-group-item d-flex justify-content-between">
                                <span>@(string.IsNullOrWhiteSpace(item.VariantLabel) ? item.ProductName : $"{item.ProductName} ({item.VariantLabel})") × @item.Quantity</span>
                                <span>@((item.UnitPrice * item.Quantity).ToString("N2")) EGP</span>
                            </li>
                        }
                    </ul>
                }
                <div class="d-flex gap-2 flex-wrap">
                    <a asp-controller="Orders" asp-action="Details" asp-route-id="@Model.Id" class="btn btn-custom-primary">View order</a>
                    <a asp-controller="Products" asp-action="Index" class="btn btn-custom-secondary">Continue shopping</a>
                </div>
            </div>
        </div>
    </div>
</div>
