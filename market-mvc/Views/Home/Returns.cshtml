@inject market_mvc.Infrastructure.Localization.IZontaLocalizer L
@{
    var isAr = L.Culture == "ar";
    ViewData["Title"] = isAr ? "الاستبدال والاسترجاع" : "Returns & Exchanges";
    ViewBag.PageTitle = isAr ? "الاستبدال والاسترجاع" : "Returns & Exchanges";
    ViewBag.Breadcrumbs = new List<(string Name, string Controller, string Action)> { ((isAr ? "الاسترجاع" : "Returns"), "Home", "Returns") };
    var lastUpdated = "2026-10-11";
}
@await Html.PartialAsync("_PageHeader")
<div class="container">
    <div class="content-card">
        <div class="col-md-8 mx-auto">
            <p class="text-muted small text-center">@(isAr ? "آخر تحديث" : "Last updated"): @lastUpdated</p>

            @if (isAr)
            {
                <h2 class="h4">سياسة الاستبدال والاسترجاع</h2>
                <p>تنطبق على الطلبات المنفَّذة عبر متجر زونتا مصر على هذه المنصة (أحذية وملابس وإكسسوارات).</p>

                <h2 class="h4">مدة الطلب</h2>
                <ul>
                    <li>يمكنك طلب <strong>استبدال المقاس</strong> أو <strong>الاسترجاع</strong> خلال <strong>14 يوماً</strong> من تاريخ الاستلام.</li>
                    <li>يجب أن يكون المنتج بحالته الأصلية: غير مستخدم، مع البطاقات/الملصقات، وفي التغليف الأصلي قدر الإمكان.</li>
                </ul>

                <h2 class="h4">ما لا يُقبل إرجاعه</h2>
                <ul>
                    <li>منتجات تظهر عليها آثار استخدام أو تلف من العميل.</li>
                    <li>منتجات بدون بطاقات أصلية عندما تكون البطاقات جزءاً من المنتج.</li>
                    <li>عروض أو تصفيات مُعلن أنها نهائية البيع (إن وُجدت لاحقاً).</li>
                </ul>

                <h2 class="h4">عيوب التصنيع</h2>
                <p>إذا وصل المنتج معيباً أو مختلفاً عن الوصف، تواصل خلال <strong>48 ساعة</strong> من الاستلام مع صور ورقم الطلب. نستبدل المنتج أو نسترجع قيمته وفق توفر المخزون.</p>

                <h2 class="h4">طريقة الاسترداد</h2>
                <ul>
                    <li>الطلبات بـ <strong>الدفع عند الاستلام</strong>: يُفضَّل الاستبدال بنفس القيمة؛ أو استرداد نقدي/تحويل بعد استلام المرتجع وفحصه (خلال 7–14 يوم عمل تقريباً).</li>
                    <li>رسوم إعادة الشحن: يتحملها المتجر في حال العيب أو الخطأ؛ وقد يتحملها العميل في الاسترجاع الاختياري حسب الحالة.</li>
                </ul>

                <h2 class="h4">كيف تبدأ الطلب</h2>
                <ol>
                    <li>افتح <a asp-controller="Home" asp-action="Contact">صفحة التواصل</a> واذكر رقم الطلب وسبب الإرجاع.</li>
                    <li>انتظر تعليمات العنوان/الاستلام من فريق الدعم.</li>
                    <li>لا تُرجع الشحنة قبل الموافقة حتى لا تُرفض.</li>
                </ol>

                <h2 class="h4">ملاحظات</h2>
                <p>قد تُحدَّث التفاصيل التشغيلية (شركات الشحن، المهل) دون إشعار مسبق؛ يسري تاريخ «آخر تحديث» أعلاه. لأسئلة إضافية راجع صفحة التواصل.</p>
            }
            else
            {
                <h2 class="h4">Returns &amp; exchanges policy</h2>
                <p>Applies to orders fulfilled through the Zonta Egypt storefront on this platform (footwear, apparel, accessories).</p>

                <h2 class="h4">Request window</h2>
                <ul>
                    <li>You may request a <strong>size exchange</strong> or <strong>return</strong> within <strong>14 days</strong> of delivery.</li>
                    <li>Items must be unused, with original tags/labels, and in original packaging where possible.</li>
                </ul>

                <h2 class="h4">What cannot be returned</h2>
                <ul>
                    <li>Items showing wear, use, or customer damage.</li>
                    <li>Items missing original tags when tags are part of the product.</li>
                    <li>Final-sale / clearance items when explicitly marked (if offered later).</li>
                </ul>

                <h2 class="h4">Manufacturing defects</h2>
                <p>If an item arrives defective or not as described, contact us within <strong>48 hours</strong> of delivery with photos and the order number. We will exchange or refund according to stock availability.</p>

                <h2 class="h4">Refund method</h2>
                <ul>
                    <li><strong>Cash-on-delivery</strong> orders: same-value exchange is preferred; otherwise a cash/transfer refund after the return is received and inspected (typically 7–14 business days).</li>
                    <li>Return shipping: covered by the store for defects or our error; may be borne by the customer for optional returns, case by case.</li>
                </ul>

                <h2 class="h4">How to start</h2>
                <ol>
                    <li>Open the <a asp-controller="Home" asp-action="Contact">contact page</a> with your order number and reason.</li>
                    <li>Wait for return address / pickup instructions from support.</li>
                    <li>Do not ship a return before approval — it may be refused.</li>
                </ol>

                <h2 class="h4">Notes</h2>
                <p>Operational details (couriers, cut-offs) may change; the “Last updated” date above applies. For other questions use the contact page.</p>
            }
            <a asp-controller="Home" asp-action="Index" class="btn btn-custom-primary mt-3">@L.Get("Page.BackHome")</a>
        </div>
    </div>
</div>
