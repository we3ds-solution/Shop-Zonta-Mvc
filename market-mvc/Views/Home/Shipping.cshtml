@inject market_mvc.Infrastructure.Localization.IZontaLocalizer L
@{
    var isAr = L.Culture == "ar";
    ViewData["Title"] = isAr ? "الشحن" : "Shipping";
    ViewBag.PageTitle = isAr ? "الشحن" : "Shipping";
    ViewBag.Breadcrumbs = new List<(string Name, string Controller, string Action)> { ((isAr ? "الشحن" : "Shipping"), "Home", "Shipping") };
}
@await Html.PartialAsync("_PageHeader")
<div class="container">
    <div class="content-card">
        <div class="col-md-8 mx-auto">
            @if (isAr)
            {
                <div class="alert alert-success" role="note"><strong>قاعدة موثقة:</strong> شحن مجاني لجميع الطلبات فوق 750 جنيه (إعلان رسمي، مؤرشف 2024-12-21).</div>
                <h2 class="h4">كيف يعمل التوصيل</h2>
                <ul>
                    <li>الدفع عند الاستلام داخل مصر.</li>
                    <li>الطلبات <strong>750 جنيه فأكثر تُشحن مجانا</strong>؛ قد يُطبق رسم ثابت تحت ذلك (الإعداد الحالي <code>Zonta:ShippingFee</code>، الافتراضي 0 — يحتاج تأكيدا).</li>
                    <li>يظهر الشحن عند الدفع ويُحتسب في الإجمالي على الخادم.</li>
                </ul>
                <div class="alert alert-warning" role="note"><strong>مسودة — تتطلب تأكيدا (آخر مراجعة 2026-10-10).</strong> المناطق والمدد والرسم تحت العتبة ليست سياسة معتمدة بعد.</div>
            }
            else
            {
                <div class="alert alert-success" role="note"><strong>Verified store rule:</strong> free shipping on all orders over 750 EGP (official announcement, archived 2024-12-21).</div>
                <h2 class="h4">How delivery works</h2>
                <ul>
                    <li>Cash on delivery within Egypt.</li>
                    <li>Orders of <strong>750 EGP or more ship free</strong>; a flat fee may apply below that (currently configured: <code>Zonta:ShippingFee</code>, default 0 — needs business confirmation).</li>
                    <li>Shipping is shown at checkout and included in the server-calculated total.</li>
                </ul>
                <div class="alert alert-warning" role="note"><strong>Draft — requires business confirmation (last reviewed 2026-10-10).</strong> Zones, timelines and the below-threshold fee below are not yet approved company policy.</div>
            }
            <a asp-controller="Home" asp-action="Index" class="btn btn-custom-primary">@L.Get("Page.BackHome")</a>
        </div>
    </div>
</div>
