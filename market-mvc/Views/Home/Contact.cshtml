@inject market_mvc.Infrastructure.Localization.IZontaLocalizer L
@{
    ViewData["Title"] = L.Get("Contact.Title");
    ViewData["Description"] = "Contact Zonta Egypt.";
    ViewBag.PageTitle = L.Get("Contact.Title");
    ViewBag.Breadcrumbs = new List<(string Name, string Controller, string Action)>
    {
        (L.Get("Contact.Title"), "Home", "Contact")
    };
    var isAr = L.Culture == "ar";
}

@await Html.PartialAsync("_PageHeader")

<div class="container">
    <div class="content-card">
        <div class="row">
            <div class="col-md-8 mx-auto">
                <h2 class="h4">@L.Get("Contact.Heading")</h2>
                <p>@L.Get("Contact.Body")</p>
                <ul>
                    <li>Instagram: <a href="https://www.instagram.com/shop.zonta/?hl=en" target="_blank" rel="noopener">@@shop.zonta</a></li>
                    <li>@(isAr ? "المتجر الرسمي:" : "Official store:") <a href="https://shopzonta.com" target="_blank" rel="noopener">shopzonta.com</a></li>
                </ul>
                <div class="alert alert-warning" role="note">
                    @L.Get("Contact.Warn")
                </div>
                <a asp-controller="Home" asp-action="Index" class="btn btn-custom-primary">@L.Get("Page.BackHome")</a>
            </div>
        </div>
    </div>
</div>
