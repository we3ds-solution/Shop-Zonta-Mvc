@model market_mvc.Domain.entity.Order
@inject market_mvc.Infrastructure.Localization.IZontaLocalizer L

@{
    ViewData["Title"] = L.Get("Orders.UpdateStatus");
    ViewBag.PageTitle = $"{Model.OrderNumber}";
    ViewBag.Breadcrumbs = new List<(string Name, string Controller, string Action)>
    {
        (L.Get("Orders.Title"), "Orders", "Index"),
        (L.Get("Orders.UpdateStatus"), "Orders", "Edit")
    };
}

@await Html.PartialAsync("_PageHeader")

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="content-card mb-3">
                <dl class="row mb-0">
                    <dt class="col-sm-4">@L.Get("Orders.Number")</dt>
                    <dd class="col-sm-8"><code>@Model.OrderNumber</code></dd>
                    <dt class="col-sm-4">@L.Get("Orders.Customer")</dt>
                    <dd class="col-sm-8">@Model.CustomerEmail</dd>
                    <dt class="col-sm-4">@L.Get("Orders.Total") (@(L.Culture == "ar" ? "محسوب خادميا" : "server-calculated"))</dt>
                    <dd class="col-sm-8 fw-bold">@Model.Total.ToString("N2") EGP</dd>
                    <dt class="col-sm-4">@L.Get("Orders.Status")</dt>
                    <dd class="col-sm-8">@L.StatusName(Model.Status) · @L.PayName(Model.PaymentStatus)</dd>
                </dl>
                <p class="small text-muted mb-0 mt-2">Totals, payment status, and customer are never edited here — only the fulfillment status transitions.</p>
            </div>
            <div class="form-enhanced">
                <form asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                    <input type="hidden" name="Id" value="@Model.Id" />
                    <div class="form-group">
                        <label for="Status" class="control-label">@L.Get("Orders.NewStatus")</label>
                        <select name="Status" id="Status" class="form-select">
                            @foreach (var s in Enum.GetValues<market_mvc.Domain.Enums.OrderStatus>())
                            {
                                <option value="@s" selected="@(s == Model.Status)">@s</option>
                            }
                        </select>
                    </div>
                    <div class="form-group d-flex gap-2 flex-wrap">
                        <button type="submit" class="btn btn-custom-primary">@L.Get("Orders.UpdateBtn")</button>
                        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-custom-secondary">@L.Get("Orders.ViewDetails")</a>
                        <a asp-action="Index" class="btn btn-custom-secondary">@L.Get("Orders.Back")</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
