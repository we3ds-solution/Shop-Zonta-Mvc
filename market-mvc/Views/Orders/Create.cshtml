@inject market_mvc.Infrastructure.Localization.IZontaLocalizer L
@{
    ViewData["Title"] = L.Get("Ord.CreateTitle");
    ViewBag.PageTitle = L.Get("Ord.CreateTitle");
    ViewBag.Breadcrumbs = new List<(string Name, string Controller, string Action)>
    {
        (L.Get("Orders.Title"), "Orders", "Index"),
        (L.Get("Ord.CreateTitle"), "Orders", "Create")
    };
}

@await Html.PartialAsync("_PageHeader")

<div class="container">
    <div class="content-card text-center py-5">
        <h2>@L.Get("Ord.CreateBody")</h2>
        <p class="text-muted">@L.Get("Ord.CreateHint")</p>
        <div class="d-flex gap-2 justify-content-center flex-wrap">
            <a asp-controller="Cart" asp-action="Index" class="btn btn-custom-primary">@L.Get("Ord.GoCart")</a>
            <a asp-controller="Products" asp-action="Index" class="btn btn-custom-secondary">@L.Get("Ord.ShopLink")</a>
        </div>
    </div>
</div>
