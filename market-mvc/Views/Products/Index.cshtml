@model market_mvc.Domain.PaginatedResult<market_mvc.Domain.entity.Product>
@inject market_mvc.Infrastructure.Localization.IZontaLocalizer L

@{
    ViewData["Title"] = L.Get("Shop.Title");
    ViewData["Description"] = "Shop Zonta Egypt — Arabic sneakers and streetwear.";
    ViewBag.PageTitle = L.Get("Shop.Title");
    ViewBag.Breadcrumbs = new List<(string Name, string Controller, string Action)>
    {
        (L.Get("Shop.Title"), "Products", "Index")
    };
}

@await Html.PartialAsync("_PageHeader")

<div class="container">
    @await Html.PartialAsync("_SearchFilter")

    @* Collections (official store groups: all shoes, men, women — mapped to local categories) *@
    <div class="d-flex gap-2 justify-content-center flex-wrap mb-4" role="navigation" aria-label="Collections">
        <a asp-action="Index" class="btn btn-sm @(string.IsNullOrEmpty(Context.Request.Query["category"]) ? "btn-custom-primary" : "btn-custom-secondary")">@L.Get("Shop.All")</a>
        <a asp-action="Index" asp-route-category="Sneakers" class="btn btn-sm @(Context.Request.Query["category"] == "Sneakers" ? "btn-custom-primary" : "btn-custom-secondary")">Sneakers</a>
        <a asp-action="Index" asp-route-category="Apparel" class="btn btn-sm @(Context.Request.Query["category"] == "Apparel" ? "btn-custom-primary" : "btn-custom-secondary")">Apparel</a>
        <a asp-action="Index" asp-route-category="Accessories" class="btn btn-sm @(Context.Request.Query["category"] == "Accessories" ? "btn-custom-primary" : "btn-custom-secondary")">Accessories</a>
        <a asp-controller="Home" asp-action="SizeGuide" class="btn btn-sm btn-custom-secondary">@L.Get("Shop.SizeGuide")</a>
    </div>

    <div class="content-card">
        @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
        {
            <div class="action-buttons">
                <a asp-action="Create" class="btn btn-custom-primary">
                    <i class="fas fa-plus me-2"></i>@(L.Culture == "ar" ? "إضافة منتج (إدارة)" : "Add product (admin)")
                </a>
            </div>
        }

        @if (!Model.Items.Any())
        {
            <div class="text-center py-5" role="status">
                <i class="fas fa-shoe-prints fa-3x text-muted mb-3" aria-hidden="true"></i>
                <h3>@L.Get("Shop.Empty")</h3>
                <p class="text-muted">@L.Get("Shop.EmptyHint")</p>

                @* Real brand imagery from @shop.zonta so the empty shop still shows the product *@
                <div class="row row-cols-2 row-cols-md-3 g-3 mt-3 justify-content-center">
                    <div class="col-6 col-md-3">
                        <img src="/images/categories/footwear/premium-leather.jpg"
                             alt="@L.Get("Gallery.AltHabibi")" loading="lazy"
                             class="img-fluid rounded shadow-sm w-100" style="aspect-ratio: 1/1; object-fit: cover;" />
                    </div>
                    <div class="col-6 col-md-3">
                        <img src="/images/categories/apparel/lifestyle-brunch.jpg"
                             alt="@L.Get("Gallery.AltShop")" loading="lazy"
                             class="img-fluid rounded shadow-sm w-100" style="aspect-ratio: 1/1; object-fit: cover;" />
                    </div>
                    <div class="col-6 col-md-3">
                        <img src="/images/categories/accessories/rep-language.jpg"
                             alt="@L.Get("Gallery.AltLanguage")" loading="lazy"
                             class="img-fluid rounded shadow-sm w-100" style="aspect-ratio: 1/1; object-fit: cover;" />
                    </div>
                </div>

                <a href="https://www.instagram.com/shop.zonta/?hl=en" target="_blank" rel="noopener" class="btn btn-custom-primary mt-3">
                    <i class="fab fa-instagram me-1" aria-hidden="true"></i>@@shop.zonta
                </a>
            </div>
        }

        <div id="resultsContainer">
            @await Html.PartialAsync("_ProductList", Model.Items)
        </div>

        <div id="paginationContainer"></div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Initialize search and filter functionality
            const searchManager = new SearchFilterManager({
                searchUrl: '@Url.Action("Index", "Products")',
                filterSelects: ['#PriceRange']
            });

            // Set initial data if we have results
            @if (Model.TotalItems > 0)
            {
                <text>
                searchManager.totalItems = @Model.TotalItems;
                searchManager.currentPage = @Model.CurrentPage;
                searchManager.pageSize = @Model.PageSize;
                searchManager.totalPages = @Model.TotalPages;
                searchManager.updateResultsInfo();
                searchManager.updatePagination();
                </text>
            }
        });
    </script>
}
