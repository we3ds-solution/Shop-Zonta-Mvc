@model IEnumerable<market_mvc.Domain.entity.Product>

@if (Model.Any())
{
    <div class="table-responsive">
        <table class="table table-enhanced mb-0">
            <thead>
                <tr>
                    <th class="d-none d-md-table-cell"><i class="fas fa-image me-2"></i>Image</th>
                    <th><i class="fas fa-tag me-2"></i>Name</th>
                    <th><i class="fas fa-dollar-sign me-2"></i>Price</th>
                    <th><i class="fas fa-cogs me-2"></i>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="d-none d-md-table-cell">
                            @if (!string.IsNullOrEmpty(item.ImageUrl))
                            {
                                <img src="@item.ImageUrl" alt="@item.Name" class="product-image" loading="lazy" onerror="this.onerror=null;this.src='/images/products/placeholder.svg';" />
                            }
                            else
                            {
                                <div class="product-image-placeholder">
                                    <i class="fas fa-image"></i>
                                </div>
                            }
                        </td>
                        <td>
                            <div class="d-flex align-items-center">
                                <div class="d-md-none me-2">
                                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                                    {
                                        <img src="@item.ImageUrl" alt="@item.Name" class="product-image" loading="lazy" onerror="this.onerror=null;this.src='/images/products/placeholder.svg';" />
                                    }
                                    else
                                    {
                                        <div class="product-image-placeholder">
                                            <i class="fas fa-image"></i>
                                        </div>
                                    }
                                </div>
                                <strong>@Html.DisplayFor(modelItem => item.Name)</strong>
                            </div>
                        </td>
                        <td>
                            <span class="badge bg-success fs-6">@item.Price.ToString("N2") EGP</span>
                        </td>
                        <td>
                            <div class="btn-group" role="group">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-dark btn-sm" title="View Details">
                                    <i class="fas fa-eye"></i>
                                    <span class="d-none d-lg-inline ms-1">Details</span>
                                </a>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-dark btn-sm" title="Edit">
                                    <i class="fas fa-edit"></i>
                                    <span class="d-none d-lg-inline ms-1">Edit</span>
                                </a>
                                <button type="button" class="btn btn-danger btn-sm" title="Delete"
                                        onclick="showDeleteModal('Product', '@item.Id', '@item.Name', '@Url.Action("Delete", "Products", new { id = item.Id })', 'Price: @item.Price.ToString("N2") EGP')">
                                    <i class="fas fa-trash"></i>
                                    <span class="d-none d-lg-inline ms-1">Delete</span>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="text-center py-5">
        <i class="fas fa-box-open fa-3x text-muted mb-3"></i>
        <h4 class="text-muted">No Products Found</h4>
        <p class="text-muted">Try adjusting your search criteria or create a new product.</p>
        <a asp-action="Create" class="btn btn-custom-primary">
            <i class="fas fa-plus me-2"></i>Create First Product
        </a>
    </div>
}
